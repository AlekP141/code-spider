# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# NOTE: /node_modules is root-anchored on purpose. test-code/*/node_modules is
# committed test data (see plan Task 6) and must NOT be ignored.
/node_modules
/packages/*/node_modules

# testing
/coverage
.vscode-test/

# build output
/packages/*/dist
/build
*.vsix
# generated by package:vsix from the root README
/packages/extension/README.md

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# agent workflow artifacts
local-agent-docs/
