{
  "name": "@code-spider/webview",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./protocol": "./src/host/protocol.ts",
    "./column-gap": "./src/settings/column-gap.ts",
    "./edge-style": "./src/settings/edge-style.ts",
    "./diff-mode": "./src/settings/diff-mode.ts",
    "./test-visibility": "./src/settings/test-visibility.ts"
  },
  "scripts": {
    "build": "node build.mjs",
